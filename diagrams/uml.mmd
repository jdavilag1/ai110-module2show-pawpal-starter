classDiagram
    class Owner {
        +name: str
        +available_minutes_per_day: int
        +preferences: list~str~
        +add_pet(pet: Pet): None
        +update_preferences(preferences: list~str~): None
    }

    class Pet {
        +name: str
        +species: str
        +breed: str
        +age_years: int
        +add_task(task: Task): None
        +list_pending_tasks(): list~Task~
    }

    class Task {
        +title: str
        +category: str
        +duration_minutes: int
        +priority: str
        +due_time: str
        +completed: bool
        +scheduled_time: str
        +mark_completed(): None
        +is_due(): bool
    }

    class Scheduler {
        +generate_daily_plan(owner: Owner): list~Task~
        +explain_plan(plan: list~Task~): str
    }

    Owner "1" o-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : has care tasks
    Scheduler ..> Owner : reads availability and preferences
    Scheduler ..> Pet : plans care for
    Scheduler ..> Task : selects and orders
