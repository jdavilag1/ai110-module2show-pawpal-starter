classDiagram
    class Owner {
        +name: str
        +available_minutes_per_day: int
        +preferences: list~str~
        +pets: list~Pet~
        +mark_task_complete(task: Task, on_date: date): Task | None
        +add_pet(pet: Pet): None
        +update_preferences(preferences: list~str~): None
        +get_all_tasks(): list of (Pet, Task)
    }

    class Pet {
        +name: str
        +species: str
        +breed: str
        +age_years: int
        +tasks: list~Task~
        +add_task(task: Task): None
        +list_pending_tasks(on_date: date): list~Task~
        +mark_task_complete(task: Task, on_date: date): Task | None
    }

    class Task {
        +description: str
        +duration_minutes: int
        +frequency: once | daily | weekly
        +priority: low | medium | high
        +due_time: time | None
        +category: str
        +completed: bool
        +scheduled_time: time | None
        +last_completed_on: date | None
        +time: str | None
        +mark_completed(on_date: date): Task | None
        +is_due(on_date: date): bool
    }

    class Scheduler {
        +start_time: time
        +unscheduled_tasks: list of (Pet, Task, str)
        +sort_tasks(tasks): list~Task~
        +filter_tasks(owner, completed, pet_name): list of (Pet, Task)
        +detect_conflicts(assignments): list~str~
        +generate_daily_plan(owner: Owner, on_date: date): list of (Pet, Task)
        +explain_plan(plan: list of (Pet, Task)): str
    }

    Owner "1" o-- "0..*" Pet : cares for
    Pet "1" *-- "0..*" Task : has care tasks
    Scheduler ..> Owner : gets all pet task pairs
    Scheduler ..> Pet : assigns tasks
    Scheduler ..> Task : filters, prioritizes, schedules
